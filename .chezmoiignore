{{- /*
Per-host file scoping.
Paths are relative to the target directory (home), not the source tree.
*/ -}}

{{ if ne .chezmoi.hostname "hephaistos" }}
.local/bin/op
{{/* gaia mounts the vault from niri's spawn-at-startup; hephaistos is
     headless and had nothing mounting it at all, which silently stopped its
     backups on 2026-04-15. */}}
.config/systemd/user/rclone-vault.service
{{ end }}

{{/* Hook runtime logs — machine-local churn, and allow-compound.log is tens of MB. */}}
.claude/hooks/*.log

{{ if ne .chezmoi.hostname "gaia" }}
.local/bin/ssh-wake-proxy
.local/bin/hephaistos-status
.local/bin/hephaistos-up
.local/bin/hephaistos-off
.local/bin/stream-hephaistos
.local/bin/mount-hephaistos
.local/bin/umount-hephaistos
{{ end }}
