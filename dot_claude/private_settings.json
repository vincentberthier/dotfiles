{
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_DISABLE_MOUSE": "1",
    "CLAUDE_CODE_TMPDIR": "/var/tmp"
  },
  "permissions": {
    "allow": [
      "Bash(~/.claude:*)",
      "Bash(cargo:*)",
      "Bash(chmod:*)",
      "Bash(clang-format:*)",
      "Bash(clang-tidy:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(docker:*)",
      "Bash(echo:*)",
      "Bash(eslint:*)",
      "Bash(eza:*)",
      "Bash(exa:*)",
      "Bash(fd:*)",
      "Bash(gh:*)",
      "Bash(go:*)",
      "Bash(hadolint:*)",
      "Bash(jj:*)",
      "Bash(jq:*)",
      "Bash(just:*)",
      "Bash(libreoffice:*)",
      "Bash(make:*)",
      "Bash(md5sum:*)",
      "Bash(mkdir:*)",
      "Bash(mmdc:*)",
      "Bash(mv:*)",
      "Bash(pandoc:*)",
      "Bash(pdfgrep:*)",
      "Bash(pdfinfo:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pgrep:*)",
      "Bash(pkill:*)",
      "Bash(printf:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(rg:*)",
      "Bash(ruff:*)",
      "Bash(rustup:*)",
      "Bash(sd:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",
      "Bash(sort:*)",
      "Bash(swift:*)",
      "Bash(tar:*)",
      "Bash(test:*)",
      "Bash(tokei:*)",
      "Bash(touch:*)",
      "Bash(trash:*)",
      "Bash(tsc:*)",
      "Bash(ty:*)",
      "Bash(typst:*)",
      "Bash(udiskctl:*)",
      "Bash(uv:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(xxd:*)",
      "Bash(xxhsum:*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Read(*)",
      "Skill(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Write(*)",
      "mcp__plugin_tyrex-debugger_mcp-debugger__*"
    ],
    "deny": [
      "Read(/home/vincent/.ssh/*)",
      "Read(/home/vincent/.config/glab-cli/config.yml)"
    ]
  },
  "model": "opus[1m]",
  "deniedMcpServers": [
    {
      "serverName": "claude_ai_Gmail"
    },
    {
      "serverName": "claude_ai_Google_Calendar"
    },
    {
      "serverName": "claude_ai_Google_Drive"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/vincent/.claude/hooks/allow-compound.py"
          },
          {
            "type": "command",
            "command": "python3 /home/vincent/.claude/hooks/block-rg-replace.py"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/home/vincent/.claude/hooks/block-exit-plan-mode.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/vincent/.claude/hooks/chezmoi-guard.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/vincent/.claude/hooks/clean-scratchpad.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/tyrex-statusline",
    "padding": 3
  },
  "enabledPlugins": {
    "claudit@quickstop": false,
    "playground@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "cowork-plugin-management@knowledge-work-plugins": true,
    "skill-creator@claude-plugins-official": true,
    "tyrex-dev@tyrex-plugins": true,
    "tyrex-starter@tyrex-plugins": true,
    "tyrex-workflow@tyrex-plugins": true,
    "tyrex-knowledge@tyrex-plugins": true,
    "tyrex-core@tyrex-plugins": true,
    "tyrex-vcs@tyrex-plugins": true,
    "tyrex-workflow-light@tyrex-plugins": true,
    "tyrex-agents@tyrex-plugins": true,
    "tyrex-gitlab@tyrex-plugins": true,
    "tyrex-assurance@tyrex-plugins": true,
    "tyrex-jj@tyrex-plugins": true,
    "tyrex-conformity@tyrex-plugins": true,
    "tyrex-documents@tyrex-plugins": true,
    "tyrex-lang-common@tyrex-plugins": true,
    "tyrex-security@tyrex-plugins": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "tyrex-plugins": {
      "source": {
        "source": "git",
        "url": "git@tyrex-gl01-dev.kub.local:tyrex/research-and-development/ai-agents.git",
        "ref": "marketplace"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "high",
  "plansDirectory": "./.claude/plans",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true
}
