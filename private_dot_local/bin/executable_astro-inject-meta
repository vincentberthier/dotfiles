#!/usr/bin/env python3
"""Inject astrophotography metadata from a YAML sidecar into an exported JPG.

The sidecar is produced by astro_hibou.py at the end of the Siril pipeline,
next to the final FIT in process/. After GIMP + darktable export, this script
reads the sidecar, maps the JPG back to it by (target name, mode), and writes
the metadata as EXIF + XMP via exiftool.

Usage:
    astro_inject_meta.py [-v] [--dry-run] [--force] [--sidecar PATH]
                         <jpg-or-dir>...

Idempotency: a custom XMP-astrohibou:InjectedBy signature tag marks files
already processed; re-runs skip them unless --force is passed.

Pair handling: when given <name>.jpg, also processes <name>-web.jpg (and
vice versa) so master + web stay in sync.

Requires: exiftool (perl-image-exiftool), PyYAML.
Custom XMP namespace defined in ~/.ExifTool_config.
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import unicodedata
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Iterable

import yaml


DSO_ROOT = Path(os.environ.get("ASTRO_HIBOU_DSO_ROOT",
                               "/run/media/vincent/Corrbolg/dso"))
RAWS_ROOT = DSO_ROOT / "data"

# The 2026-07-20 reorg moved processing out of data/<target>/process/ into a
# top-level process/ tree that mirrors data/ (REORG_PLAN.md §2). Sidecars are
# written beside their FITS (§3b), so they moved with it — and this script's
# discovery globs were not in the list of call sites updated at the time, which
# silently broke every injection from that date on. Both layouts are searched
# now, so a re-run over the archive works regardless of when a file was made.
PROCESS_ROOT = Path(os.environ["ASTRO_HIBOU_PROCESS_PATH"]) \
    if os.environ.get("ASTRO_HIBOU_PROCESS_PATH") else DSO_ROOT / "process"
PRODUCTS_ROOT = DSO_ROOT / "products"

EXPORT_ROOT = Path.home() / "Images/Photos/Astro"
INJECTOR_VERSION = "astro_inject_meta v1"

# JPG filename: YYYY-MM-DD_<target>[-<mode>][-extra...][_variant][-web].jpg
#
# The mode is optional: the earliest exports predate the mode suffix entirely
# ("2025-06-23_M11.jpg"), and rejecting them meant they could never be injected.
# A trailing "_variant" ("_16bit", "_syqon", "_v2") is a processing variant of
# the same acquisition, so it is captured and discarded for matching purposes.
# The lookaheads keep "-web" out of the mode and extra groups. Without them a
# mode-less name like "2025-07-19_NGC7293-web.jpg" parses with mode="WEB",
# which matches no sidecar and silently strands every mode-less web twin.
RE_JPG = re.compile(
    r"^(?P<date>\d{4}-\d{2}-\d{2})_(?P<target>[^_-]+?)"
    r"(?:-(?!web\b)(?P<mode>[A-Za-z]+))?"
    r"(?P<extra>(?:-(?!web\b)[^-_]+)*?)"
    r"(?:_(?P<variant>[^-]+))?"
    r"(?P<web>-web)?\.jpg$"
)

# Modes we recognise as recombination outputs from astro_hibou.py.
KNOWN_MODES = {"LRGB", "RGB", "SHO", "HOO", "OHS", "HSO", "FORAX", "FORAXX",
               "HALRGB_R", "HALRGB_L"}

# Wide-field / nightscape exports: no target, no mode, no FITS anywhere. They
# get authorship and rights only — there is no acquisition metadata to recover
# and inventing any would be worse than leaving the fields absent.
NIGHTSCAPES = {
    "Constellations": "Constellations",
    "MilkyWay": "Voie lactée / Milky Way",
    "Timelapse": "Timelapse",
}

AUTHOR = {"name": "Vincent Berthier", "email": "contact@astro-hibou.eu"}

# Catalogue designations whose data lives under a folder named for the object's
# common name. normalize_target() cannot bridge those — "B33" and
# "horsehead-nebula" share no characters — so each needs an explicit mapping.
#
# Empty as of 2026-07-25: the three folders that needed entries here
# (horsehead-nebula, nebuleuse-du-dragon-chinois, tweedledum-cluster) were
# renamed to b-33, ngc-6559 and ngc-6633, so every export's target token now
# matches its folder directly. Keep this table for the next common-name folder
# rather than deleting it.
TARGET_ALIASES: dict[str, str] = {}


def normalize_target(name: str) -> str:
    """Reduce a target name to a separator- and accent-insensitive match key.

    Keeps everything alphanumeric and discards the rest, so every spelling of a
    target collapses to one key:

        "M 51"  "m-51"  "m51"                    -> "m51"
        "NGC 7023"  "ngc-7023"                   -> "ngc7023"
        "Nebuleuse du Dragon chinois"
        "nebuleuse-du-dragon-chinois"            -> "nebuleusedudragonchinois"

    This previously stripped whitespace and lowercased only, which was enough to
    match folder names against sidecars while folders were spelled "M 51". Once
    tools/normalize_target_dirs.py renames them to "m-51", the hyphen has to
    fold away too -- and accents with it, since "Nebuleuse" and its accented
    form must not key differently.
    """
    folded = unicodedata.normalize("NFKD", name or "")
    folded = "".join(c for c in folded if not unicodedata.combining(c))
    return re.sub(r"[^a-z0-9]+", "", folded.lower())


def parse_jpg_name(jpg: Path) -> tuple[str, str | None, bool] | None:
    """Return (target_token, mode_upper_or_None, is_web) or None if unparseable.

    The mode group is [A-Za-z]+, so it stops at the hyphen in a name like
    2026-07-10_M101-HaLRGB-R.jpg and yields "HALRGB" while the "-R" falls into
    the extra group. Sidecars written by the pipeline record the full
    "HALRGB_R", and find_sidecar rejects on mode before it ever compares
    targets -- so every one of those exports silently found no sidecar.

    Re-attach the leading extra segment when doing so names a known mode.

    The mode is optional and comes back as None for the earliest exports, which
    predate the suffix entirely ("2025-06-23_M11.jpg"). None means "match on
    target alone" rather than "no match".
    """
    m = RE_JPG.match(jpg.name)
    if not m:
        return None

    mode = m["mode"].upper() if m["mode"] else None
    extra = (m["extra"] or "").strip("-")
    if mode and extra:
        # "R", "L", or a decorated "R_v2" -- only the leading token qualifies.
        token = re.split(r"[-_]", extra)[0].upper()
        if token and f"{mode}_{token}" in KNOWN_MODES:
            mode = f"{mode}_{token}"

    return m["target"], mode, bool(m["web"])


def _iter_sidecars() -> Iterable[tuple[Path, str]]:
    """Yield (sidecar, target_folder) across every layout this archive has used.

    Post-reorg (2026-07-20), sidecars live beside their FITS under the
    top-level process/ and products/ trees. Pre-reorg they sat under
    data/<target>/[<date>/]process/. Both are searched so one pass covers the
    whole archive; a target that exists in several trees simply yields several
    candidates, which find_sidecar then disambiguates on mode.
    """
    for root in (PROCESS_ROOT, PRODUCTS_ROOT):
        if not root.is_dir():
            continue
        for sidecar in root.glob("*/**/*.meta.yaml"):
            rel = sidecar.relative_to(root)
            # ARCHIVE_* holds superseded versions of a stack that was
            # reprocessed (products/m-101/ARCHIVE_pre_parallax_v12/). They
            # describe the same target, mode and night as the live sidecar, so
            # they can only ever add a coin-flip to the date ranking.
            if any(part.startswith("ARCHIVE") for part in rel.parts[:-1]):
                continue
            yield sidecar, rel.parts[0]

    for pattern in ("*/process/*.meta.yaml", "*/*/process/*.meta.yaml"):
        for sidecar in RAWS_ROOT.glob(pattern):
            rel = sidecar.relative_to(RAWS_ROOT)
            yield sidecar, rel.parts[0]


def find_sidecar_for_export(jpg: Path) -> Path | None:
    """A sidecar named exactly after the export, if one exists.

    The date ranking in find_sidecar is a tiebreak, not a match: an export's
    filename date is its *processing* date, so two stacks of the same target
    and mode can rank in the wrong order. NGC 7023 is the worked example — the
    07-18 export is one night and the 07-19 export is two, but the two-night
    stack's DATE-OBS falls on 07-18, so ranking hands each export the other's
    sidecar. No date heuristic can separate them.

    Naming a sidecar `<export-stem>.meta.yaml` beside the products settles it
    once: an exact name beats every guess, and the pairing survives re-runs.
    """
    stem = jpg.stem[:-4] if jpg.stem.endswith("-web") else jpg.stem
    for root in (PRODUCTS_ROOT, PROCESS_ROOT):
        if not root.is_dir():
            continue
        for candidate in sorted(root.rglob(f"{stem}.meta.yaml")):
            return candidate
    return None


def _date_distance(obs: str, near: str | None) -> int:
    """Days between two YYYY-MM-DD strings, for ranking candidate sidecars.

    A missing date on either side sorts last rather than raising: an undated
    candidate is usable, just never preferred over a dated one.
    """
    if not obs or not near:
        return sys.maxsize
    try:
        a = datetime.strptime(obs, "%Y-%m-%d")
        b = datetime.strptime(near, "%Y-%m-%d")
    except ValueError:
        return sys.maxsize
    return abs((a - b).days)


def find_sidecar(target_token: str, mode: str | None,
                 near: str | None = None) -> Path | None:
    """Scan the archive for a sidecar matching the target + mode.

    `near` is the export's own date (from its filename), used to pick between
    several sessions of the same target and mode: the candidate whose
    observation date sits closest to it wins.

    M16 is why this matters: products/m-16 holds both a 2025-06-25 SHO stack
    (31 subs) and a 2025-07-13 one (110 subs). Without the date, matching is
    decided by directory-walk order, and the 2025-06-25 export silently picks
    up nine hours of integration it does not have.

    Closest-date rather than a not-after bound, because the filename date is
    not reliably the export date. It usually is (B33 is named 2025-12-13 for a
    2025-11-29 acquisition), but m-8's exports are named 2025-06-25 while their
    stack header reads 2025-06-26 — naming the session's first night while the
    header records a later sub. Rejecting anything after the filename date
    therefore throws away correct matches; ranking by distance does not, and
    needs no tolerance constant to tune.
    """
    target_n = normalize_target(target_token)
    aliased = TARGET_ALIASES.get(target_n)
    exact: list[tuple[str, Path]] = []
    fallback: list[tuple[str, Path]] = []

    for sidecar, folder in _iter_sidecars():
        try:
            with open(sidecar) as f:
                meta = yaml.safe_load(f) or {}
        except (OSError, yaml.YAMLError):
            continue
        acq = meta.get("acquisition") or {}
        # Modes are compared through normalize_target because the pipeline has
        # spelled the same mode several ways over time — "HaLRGB-R" in older
        # sidecars against the "HALRGB_R" a filename parses to. Folding away
        # case and separators makes those one value instead of two.
        sidecar_mode = normalize_target(acq.get("mode") or "")
        # A mode-less export ("2025-06-23_M11.jpg") matches on target alone;
        # it predates the mode suffix, so there is nothing to disambiguate on.
        if mode is not None and sidecar_mode != normalize_target(mode):
            continue

        obs = (acq.get("date_obs_utc") or "")[:10]
        sidecar_target = (meta.get("target") or {}).get("name") or ""
        folder_n = normalize_target(folder)
        if normalize_target(sidecar_target) == target_n:
            exact.append((obs, sidecar))
        elif folder_n == target_n or (aliased and folder_n == aliased):
            fallback.append((obs, sidecar))

    for pool in (exact, fallback):
        if len(pool) == 1:
            return pool[0][1]
        if len(pool) > 1:
            # Several sessions match; take the one observed closest to the
            # export's own date. A candidate with no date sorts last, so a
            # dated stack always beats an undated one.
            winner = min(pool, key=lambda pair: _date_distance(pair[0], near))
            if winner[0][:10] != (near or "")[:10]:
                # The pick is a guess whenever the dates do not line up and
                # more than one session was in the running. NGC 7023's 07-19
                # two-night export resolved this way to the 07-17 single-night
                # sidecar and was published with the wrong integration, in
                # silence. Say so: a nearest-date tiebreak is not a match.
                print(f"  ! ambiguous: {len(pool)} sidecars match this target "
                      f"and mode; picked the one nearest {near or '(no date)'}",
                      file=sys.stderr)
                for obs, path in sorted(pool):
                    mark = "->" if path == winner[1] else "  "
                    print(f"    {mark} {obs or '(undated)'}  {path.name}",
                          file=sys.stderr)
                print("    Verify this is the right session; pass --sidecar "
                      "to choose explicitly.", file=sys.stderr)
            return winner[1]
    return None


def to_exif_datetime(iso: str | None) -> str | None:
    """Convert 2026-03-26T21:40:44.542789 → 2026:03:26 21:40:44 (EXIF style)."""
    if not iso:
        return None
    try:
        dt = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except ValueError:
        return None
    return dt.strftime("%Y:%m:%d %H:%M:%S")


def _common_label(target_block: dict) -> str:
    """FR / EN common name, joined with ' / ' when both are set."""
    fr = (target_block.get("common_name_fr") or "").strip()
    en = (target_block.get("common_name_en") or "").strip()
    if fr and en:
        return f"{fr} / {en}"
    return fr or en


# Display order and labels for the per-channel breakdown. Short filter codes
# rather than "luminance"/"red" — they sit directly under the mode token
# ("LRGB", "SHO"), which is the same vocabulary.
CHANNEL_LABELS = [
    ("luminance", "L"), ("red", "R"), ("green", "G"), ("blue", "B"),
    ("sii", "SII"), ("ha", "Ha"), ("oiii", "OIII"),
]


def night_of(iso: str | None) -> str | None:
    """The observing night a UTC timestamp belongs to, as YYYY-MM-DD.

    A night straddles midnight, so the calendar date does not identify it:
    NGC 7023's 07-17 session ran 23:22 to 01:36 — two dates, one night.
    Shifting back 12 h puts the whole night on the date it started.
    """
    if not iso:
        return None
    try:
        dt = datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
    except ValueError:
        return None
    return (dt - timedelta(hours=12)).strftime("%Y-%m-%d")


def channel_breakdown(channels: dict | None) -> str:
    """"L 150 × 60 s, R 43 × 120 s, …" from the sidecar's channels block."""
    if not isinstance(channels, dict):
        return ""
    parts = []
    for key, label in CHANNEL_LABELS:
        ch = channels.get(key)
        if not isinstance(ch, dict) or not ch.get("frames"):
            continue
        frames = ch["frames"]
        sub = ch.get("sub_exposure_s") or 0
        total = ch.get("integration_s")
        # "N × X s" is only true when the channel ran one sub length. M 101's
        # luminance mixes the retired 2026-07-08 120 s subs with 60 s ones, so
        # its header EXPTIME describes neither — state the integration instead
        # of multiplying out a number that was never shot.
        if total is not None and abs(frames * sub - float(total)) > 1:
            hrs, rem = divmod(int(float(total)), 3600)
            parts.append(f"{label} {frames} ({hrs}h{rem // 60:02d}m)")
        else:
            parts.append(f"{label} {frames} × {sub:g} s")
    return ", ".join(parts)


def build_description(meta: dict) -> str:
    """Human-readable multi-line description packed into ImageDescription."""
    target_block = meta.get("target") or {}
    target = target_block.get("name") or "(unknown target)"
    common = _common_label(target_block)
    target_label = f"{target} - {common}" if common else target
    acq = meta.get("acquisition") or {}
    eq = meta.get("equipment") or {}
    mode = acq.get("mode") or "?"
    frames = acq.get("frames_stacked")
    sub = acq.get("sub_exposure_s")
    total_s = acq.get("total_integration_s")
    telescope = (eq.get("telescope") or "").strip()
    camera = (eq.get("camera") or "").strip()
    date = (acq.get("date_obs_utc") or "")[:10]

    if total_s:
        hrs, rem = divmod(int(total_s), 3600)
        mins = rem // 60
        total_str = f"{hrs}h{mins:02d}m"
    else:
        total_str = "?"

    # A sidecar rebuilt from light frames rather than from a stack header has
    # no recorded frame count, so any figure in it is a reconstruction. Say so
    # in the text a viewer actually reads: once these numbers are published
    # they are indistinguishable from measured ones otherwise.
    approx = "~" if acq.get("estimated") else ""
    suffix = ", estimated" if acq.get("estimated") else ""

    lines = [f"{target_label} — {mode}"]
    # The per-channel breakdown, when the sidecar carries one. An LRGB stack
    # mixes 60 s luminance with 120 s colour subs, so "N × X s" cannot describe
    # it honestly with a single exposure — spell the channels out instead.
    breakdown = channel_breakdown(acq.get("channels"))
    if frames and breakdown:
        lines.append(f"{approx}{total_str} total integration "
                     f"({approx}{frames} subs: {breakdown}{suffix}).")
    elif frames and sub and (total_s is None
                             or abs(frames * sub - float(total_s)) <= 1):
        lines.append(f"{approx}{total_str} total integration "
                     f"({approx}{frames} × {sub:g} s subs{suffix}).")
    elif frames:
        # Same trap as the per-channel breakdown, one level up: an LRGB stack's
        # header EXPTIME is an average across mixed sub lengths, so M 4 read
        # "66 × 105 s" — a sub length never shot, and 6930 s against the 7140 s
        # recorded beside it. Give the count without inventing the exposure.
        lines.append(f"{approx}{total_str} total integration "
                     f"({approx}{frames} subs{suffix}).")
    elif total_s:
        lines.append(f"{approx}{total_str} total integration{suffix}.")
    # Never publish a placeholder. M 10's sidecar was built from a
    # post-stretch FITS with ten header cards and no equipment at all, and the
    # export went out reading "M-10 — LRGB.? + ?." — a question mark tells a
    # viewer nothing that the line's absence would not.
    if telescope and camera:
        lines.append(f"{telescope} + {camera}.")
    elif telescope or camera:
        lines.append(f"{telescope or camera}.")
    if date:
        # A stack spanning several nights must not read as a single-night one
        # — the whole point of shooting it twice. Nights, not calendar dates:
        # a session running past midnight is one night on two dates.
        first = night_of(acq.get("date_obs_utc")) or date
        last = night_of(acq.get("date_last_utc"))
        if last and last != first:
            lines.append(f"Acquired on the nights of {first} and {last} UTC.")
        else:
            lines.append(f"Acquired on the night of {first} UTC.")
    return "\n".join(lines)


def gps_args(lat: float | int | None, lon: float | int | None) -> list[str]:
    """exiftool GPS args; handles missing values gracefully."""
    out: list[str] = []
    if lat is not None:
        out += [f"-GPSLatitude={abs(lat)}", f"-GPSLatitudeRef={'S' if lat < 0 else 'N'}"]
    if lon is not None:
        out += [f"-GPSLongitude={abs(lon)}", f"-GPSLongitudeRef={'W' if lon < 0 else 'E'}"]
    return out


def build_exiftool_args(meta: dict, jpg: Path) -> list[str]:
    author_name = (meta.get("author") or {}).get("name") or ""
    author_email = (meta.get("author") or {}).get("email") or ""
    author = author_name + (f" <{author_email}>" if author_email else "")

    target = meta.get("target") or {}
    acq = meta.get("acquisition") or {}
    eq = meta.get("equipment") or {}
    site = meta.get("site") or {}
    cond = meta.get("conditions") or {}
    proc = meta.get("processing") or {}

    description = build_description(meta)
    date_utc = to_exif_datetime(acq.get("date_obs_utc"))
    year = (acq.get("date_obs_utc") or "")[:4] or str(datetime.now().year)
    copyright_str = f"© {year} {author_name}".strip()

    args: list[str] = [
        # Standard EXIF
        f"-EXIF:Artist={author_name}",
        f"-EXIF:Copyright={copyright_str}",
        f"-EXIF:ImageDescription={description}",
        # Standard XMP
        f"-XMP-dc:Creator={author}",
        f"-XMP-dc:Rights={copyright_str}",
        f"-XMP-dc:Description={description}",
        f"-XMP-dc:Title={target.get('name') or ''}"
        + (f" - {_common_label(target)}" if _common_label(target) else ''),
    ]

    if date_utc:
        args += [
            f"-EXIF:DateTimeOriginal={date_utc}",
            f"-XMP-photoshop:DateCreated={date_utc}",
        ]

    args += gps_args(site.get("latitude_deg"), site.get("longitude_deg"))

    # Custom astro namespace — most fields are optional; only add if present.
    def add(tag: str, value):
        if value is None or value == "":
            return
        args.append(f"-XMP-astrohibou:{tag}={value}")

    add("Object", target.get("name"))
    add("CommonNameFr", (target.get("common_name_fr") or "").strip() or None)
    add("CommonNameEn", (target.get("common_name_en") or "").strip() or None)
    add("RA", target.get("ra_deg"))
    add("Dec", target.get("dec_deg"))
    add("Mode", acq.get("mode"))
    add("DateObsUTC", acq.get("date_obs_utc"))
    add("Frames", acq.get("frames_stacked"))
    add("SubExposure", acq.get("sub_exposure_s"))
    add("Integration", acq.get("total_integration_s"))
    add("Channels", channel_breakdown(acq.get("channels")) or None)
    # Travels with the file so a consumer can tell a reconstructed frame count
    # from one read out of a stack header.
    add("Estimated", "true" if acq.get("estimated") else None)
    add("Airmass", acq.get("airmass"))
    add("Telescope", eq.get("telescope"))
    add("Camera", eq.get("camera"))
    add("FilterWheel", eq.get("filter_wheel"))
    add("FocalLength", eq.get("focal_length_mm"))
    add("FocalRatio", eq.get("focal_ratio"))
    add("PixelSize", eq.get("pixel_size_um"))
    add("Binning", eq.get("binning"))
    add("Gain", eq.get("gain"))
    add("Offset", eq.get("offset"))
    add("SensorTemp", eq.get("sensor_temp_c"))
    add("AmbientTemp", cond.get("ambient_temp_c"))
    add("Humidity", cond.get("humidity_pct"))
    add("Pressure", cond.get("pressure_hpa"))
    add("CloudCover", cond.get("cloud_cover_pct"))
    add("WindSpeed", cond.get("wind_speed_kph"))
    add("Software", proc.get("software"))

    # Signature — lets future runs detect already-processed files.
    add("InjectedBy", INJECTOR_VERSION)
    add("InjectedAt", datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))

    return args


def build_nightscape_args(jpg: Path, title: str) -> list[str]:
    """Authorship and rights only, for wide-field frames with no acquisition data.

    These are single-shot or timelapse frames that never went through Siril, so
    there is no FITS header, no sidecar, and no integration to report. Stamping
    the author, the rights and the capture date is everything that can honestly
    be said about them; the astro namespace is left untouched rather than filled
    with placeholders.
    """
    m = RE_JPG.match(jpg.name)
    date = m["date"] if m else ""
    year = date[:4] or str(datetime.now().year)
    author = f"{AUTHOR['name']} <{AUTHOR['email']}>"
    copyright_str = f"© {year} {AUTHOR['name']}"

    args = [
        f"-EXIF:Artist={AUTHOR['name']}",
        f"-EXIF:Copyright={copyright_str}",
        f"-XMP-dc:Creator={author}",
        f"-XMP-dc:Rights={copyright_str}",
        f"-XMP-dc:Title={title}",
        f"-XMP-astrohibou:InjectedBy={INJECTOR_VERSION}",
        f"-XMP-astrohibou:InjectedAt="
        f"{datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}",
    ]
    if date:
        args.append(f"-XMP-photoshop:DateCreated={date.replace('-', ':')}")
    return args


def nightscape_title(jpg: Path) -> str | None:
    """The display title for a wide-field export, or None if it isn't one."""
    m = RE_JPG.match(jpg.name)
    token = m["target"] if m else jpg.stem.split("_", 1)[-1]
    for key, title in NIGHTSCAPES.items():
        if normalize_target(key) == normalize_target(token or ""):
            return title
    return None


def injected_by(jpg: Path) -> str:
    """The InjectedBy signature already on the file, or ""."""
    try:
        result = subprocess.run(
            ["exiftool", "-config", str(Path.home() / ".ExifTool_config"),
             "-s", "-s", "-s", "-XMP-astrohibou:InjectedBy", str(jpg)],
            capture_output=True, text=True, timeout=30, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return result.stdout.strip()


def already_injected(jpg: Path) -> bool:
    """Check the InjectedBy signature tag."""
    return bool(injected_by(jpg))


# The tool that writes metadata onto the Nikon star-trail stills. It shares the
# XMP-astrohibou namespace and the export directory, but its files have no
# sidecar and no FITS — sweeping the directory with --force used to report
# twelve failures for frames that were already correctly stamped.
FOREIGN_INJECTORS = ("inject_trail_meta",)


def run_exiftool(jpg: Path, args: list[str], dry_run: bool, verbose: bool) -> bool:
    cmd = [
        "exiftool",
        "-config", str(Path.home() / ".ExifTool_config"),
        "-overwrite_original",
        "-codedcharacterset=utf8",
        *args,
        str(jpg),
    ]
    if dry_run:
        print(f"  [dry-run] exiftool args ({len(args)} fields)")
        if verbose:
            for a in args:
                print(f"    {a}")
        return True
    result = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        print(f"  ! exiftool failed: {result.stderr.strip()}", file=sys.stderr)
        return False
    if verbose:
        print(f"  {result.stdout.strip()}")
    return True


def pair_files(jpg: Path) -> list[Path]:
    """Return [master, web] pair (filtered to those that exist)."""
    if jpg.stem.endswith("-web"):
        master = jpg.with_name(jpg.stem[:-4] + jpg.suffix)
        web = jpg
    else:
        master = jpg
        web = jpg.with_name(jpg.stem + "-web" + jpg.suffix)
    return [p for p in (master, web) if p.exists()]


def expand_inputs(inputs: Iterable[Path]) -> list[Path]:
    """Resolve dirs to their .jpg children; leave files alone."""
    out: list[Path] = []
    for p in inputs:
        if p.is_dir():
            out.extend(sorted(p.glob("*.jpg")))
        elif p.is_file():
            out.append(p)
        else:
            print(f"! Not found: {p}", file=sys.stderr)
    return out


def process_one(
    jpg: Path,
    *,
    explicit_sidecar: Path | None,
    force: bool,
    dry_run: bool,
    verbose: bool,
) -> bool:
    print(f"→ {jpg.name}")
    signature = injected_by(jpg)
    if signature and not force:
        print("  already injected (use --force to redo)")
        return True
    # Another tool owns this file's metadata. Never overwrite it on a sweep,
    # --force included: forcing means "redo my own work", not "take someone
    # else's". An explicit --sidecar is the deliberate override.
    if (signature and explicit_sidecar is None
            and any(signature.startswith(t) for t in FOREIGN_INJECTORS)):
        print(f"  skipped: metadata owned by {signature} "
              f"(pass --sidecar to override)")
        return True

    if explicit_sidecar:
        sidecar = explicit_sidecar
    else:
        title = nightscape_title(jpg)
        if title is not None:
            if verbose:
                print(f"  nightscape: authorship only ({title})")
            return run_exiftool(jpg, build_nightscape_args(jpg, title),
                                dry_run=dry_run, verbose=verbose)

        pinned = find_sidecar_for_export(jpg)
        if pinned is not None:
            if verbose:
                print(f"  sidecar (pinned by name): {pinned}")
            sidecar = pinned
            return _inject(jpg, sidecar, dry_run=dry_run, verbose=verbose)

        parsed = parse_jpg_name(jpg)
        if parsed is None:
            print("  ! Cannot parse filename. Pass --sidecar to override.",
                  file=sys.stderr)
            return False
        target_token, mode, _is_web = parsed
        if mode is not None and mode not in KNOWN_MODES and verbose:
            print(f"  (unrecognised mode '{mode}'; trying anyway)")
        name_match = RE_JPG.match(jpg.name)
        near = name_match["date"] if name_match else None
        sidecar = find_sidecar(target_token, mode, near=near)
        if sidecar is None and mode is not None:
            # No sidecar records this mode. That is the normal case for a
            # hand-built composite: "2025-06-25_M16-Custom.jpg" is a palette
            # variation of that night's SHO stack, and no pipeline run ever
            # emitted a "CUSTOM" mode. Retry on target alone — the acquisition
            # is the same, and the date ranking still picks the right session.
            sidecar = find_sidecar(target_token, None, near=near)
            if sidecar is not None and verbose:
                print(f"  (no sidecar for mode {mode}; matched on target + date)")
        if sidecar is None:
            print(f"  ! No sidecar for target='{target_token}' "
                  f"mode={mode or '(any)'}. Generate one with "
                  f"`astro-make-sidecar <stacked.fit>`, or pass --sidecar.",
                  file=sys.stderr)
            return False
        if verbose:
            print(f"  sidecar: {sidecar}")

    return _inject(jpg, sidecar, dry_run=dry_run, verbose=verbose)


def _inject(jpg: Path, sidecar: Path, *, dry_run: bool, verbose: bool) -> bool:
    """Load a resolved sidecar and stamp it into the JPG."""
    try:
        with open(sidecar) as f:
            meta = yaml.safe_load(f) or {}
    except (OSError, yaml.YAMLError) as e:
        print(f"  ! Sidecar unreadable: {e}", file=sys.stderr)
        return False

    args = build_exiftool_args(meta, jpg)
    return run_exiftool(jpg, args, dry_run=dry_run, verbose=verbose)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Inject astro YAML sidecar metadata into exported JPGs.",
    )
    parser.add_argument("inputs", nargs="+", type=Path,
                        help="JPG files or directories to scan.")
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("--dry-run", action="store_true",
                        help="Print exiftool args without writing.")
    parser.add_argument("--force", action="store_true",
                        help="Re-inject even if the signature tag is present.")
    parser.add_argument("--sidecar", type=Path,
                        help="Explicit sidecar path; skips auto-resolution.")
    args = parser.parse_args()

    if args.sidecar and not args.sidecar.exists():
        parser.error(f"Sidecar not found: {args.sidecar}")

    jpgs = expand_inputs(args.inputs)
    # Expand each JPG to its master/web pair, deduplicate.
    seen: set[Path] = set()
    targets: list[Path] = []
    for jpg in jpgs:
        for p in pair_files(jpg):
            if p not in seen:
                seen.add(p)
                targets.append(p)

    if not targets:
        print("No JPGs to process.", file=sys.stderr)
        return 1

    failures = 0
    for jpg in targets:
        ok = process_one(
            jpg,
            explicit_sidecar=args.sidecar,
            force=args.force,
            dry_run=args.dry_run,
            verbose=args.verbose,
        )
        if not ok:
            failures += 1

    if failures:
        print(f"\n{failures}/{len(targets)} failed.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
