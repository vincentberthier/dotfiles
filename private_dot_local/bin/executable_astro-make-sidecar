#!/usr/bin/env python3
"""Generate a metadata sidecar from a stacked FITS header.

The Siril pipeline (astro_hibou.py) writes a `<fits>.meta.yaml` beside each
final FITS. That mechanism is recent, so every target processed before it
landed has FITS on the drive but no sidecar — and `astro-inject-meta` has
nothing to stamp into the exported JPG.

This tool closes that gap: it reads a FITS header and writes the same sidecar
schema the pipeline produces, so the backfill path and the live path converge
on one format.

Usage:
    astro-make-sidecar [-v] [--dry-run] [--force] [--mode MODE] <fits-or-dir>...

Like the pipeline, an existing sidecar is never overwritten unless --force is
passed: sidecars are meant to be hand-edited, and a regeneration must not
silently discard that.

Requires: astropy, PyYAML.
"""

from __future__ import annotations

import argparse
import re
import sys
from datetime import datetime, timedelta
from collections import OrderedDict
from pathlib import Path
from typing import Any, Iterable

import yaml
from astropy.io import fits

DSO_ROOT = Path("/run/media/vincent/Corrbolg/dso")

# Recombination modes, longest first so "HALRGB_R" wins over "LRGB" when both
# appear in a filename like "starless_halrgb_r_denoised.fit".
KNOWN_MODES = ["HALRGB_R", "HALRGB_L", "HALRGB", "FORAXX", "FORAX",
               "LRGB", "RGB", "SHO", "HOO", "OHS", "HSO", "HOS"]

# Which per-filter masters actually feed each mode's delivered image.
#
# The recombined FITS records only what Siril's `rgbcomp` saw, and for every
# L-bearing mode the pipeline deliberately withholds the luminance from the
# linear composition (it greys the colour) and combines it after stretching.
# So the header's STACKCNT/LIVETIME cover the colour layer alone — an LRGB
# stack reports its RGB subs and silently drops the deepest channel it has.
# Summing the masters listed here restores what the published image contains.
MODE_CHANNELS = {
    "LRGB": ["luminance", "red", "green", "blue"],
    "RGB": ["red", "green", "blue"],
    "HALRGB": ["luminance", "red", "green", "blue", "ha"],
    "HALRGB_R": ["luminance", "red", "green", "blue", "ha"],
    "HALRGB_L": ["luminance", "red", "green", "blue", "ha"],
    "SHO": ["sii", "ha", "oiii"],
    "OHS": ["sii", "ha", "oiii"],
    "HSO": ["sii", "ha", "oiii"],
    "HOS": ["sii", "ha", "oiii"],
    "FORAX": ["sii", "ha", "oiii"],
    "FORAXX": ["sii", "ha", "oiii"],
    "HOO": ["ha", "oiii"],
}


def channel_totals(process_dir: Path, mode: str | None) -> dict:
    """Per-filter frames and integration for the channels `mode` uses."""
    totals: dict[str, dict] = {}
    for name in MODE_CHANNELS.get((mode or "").upper(), []):
        master = process_dir / f"master_{name}.fit"
        if not master.exists():
            continue
        try:
            with fits.open(master) as hdul:
                h = hdul[0].header
                frames = int(h.get("STACKCNT", 0) or 0)
                exptime = float(h.get("EXPTIME", 0.0) or 0.0)
                livetime = h.get("LIVETIME")
                livetime = (
                    float(livetime) if livetime is not None else frames * exptime
                )
        except (OSError, ValueError, TypeError):
            continue
        if frames:
            totals[name] = {
                "frames": frames,
                "sub_exposure_s": exptime,
                "integration_s": livetime,
                "date_obs_utc": h.get("DATE-OBS"),
            }
    return totals


def last_night(channels: dict) -> str | None:
    """Latest first-sub timestamp across channels — a lower bound on when the
    stack stopped collecting, and enough to tell one night from several.

    Only a fallback: `last_light_from_data` below is exact when the capture
    tree is reachable. A master's DATE-OBS records its *first* sub, so a night
    that only added frames to an already-open master is invisible here.
    """
    dates = [c.get("date_obs_utc") for c in channels.values()]
    dates = [d for d in dates if isinstance(d, str) and d]
    return max(dates) if dates else None


# N.I.N.A light filename:
#   NGC 7023_Blue_120.00s_0000_-10.00C_S255_H2.38_R1.35_2026-07-18_22-54-16.fits
# Group 2 is the filter, group 9 the capture time. Same expression as
# astro_hibou_core.RE_LIGHTS; keep the two in step.
RE_LIGHTS = re.compile(
    r"^([\w -]+)_([\w]+)_([\d\.]+)s_(\d{4})_"
    r"([\d\.-]+)C_S(\d+)_H([\d\.]+)_R([\d\.]+)_([\d_-]+)\.fits$"
)


def last_light_from_data(target: str | None, mode: str | None) -> str | None:
    """The exact capture time of the last sub feeding `mode`, from the lights.

    The published date is the night the acquisition FINISHED, so an approximate
    answer here quietly backdates an export. The capture tree has the exact
    one: every light's filename carries its timestamp, and a rejected frame has
    been moved out of `LIGHTS/` into the night's `DISPOSED/`, so scanning
    `LIGHTS/` counts precisely what contributed.

    Returns None when the drive is not mounted or the target has no lights —
    the caller then falls back to the masters' lower bound.
    """
    if not target:
        return None
    wanted = set(MODE_CHANNELS.get((mode or "").upper(), []))
    root = DSO_ROOT / "data" / target
    if not root.is_dir():
        return None
    latest: datetime | None = None
    for lights in root.rglob("LIGHTS"):
        if not lights.is_dir():
            continue
        for entry in lights.iterdir():
            m = RE_LIGHTS.match(entry.name)
            if not m or (wanted and m.group(2).lower() not in wanted):
                continue
            try:
                stamp = datetime.strptime(m.group(9), "%Y-%m-%d_%H-%M-%S")
            except ValueError:
                continue
            if latest is None or stamp > latest:
                latest = stamp
    return latest.isoformat() if latest is not None else None


def night_of(iso: str | None) -> str | None:
    """The observing night a UTC timestamp belongs to, as YYYY-MM-DD.

    A night straddles midnight, so the calendar date does not identify it: a
    session running 23:22 to 01:36 spans two dates and one night. Shifting
    back 12 h puts the whole night on the date it started.
    """
    if not iso:
        return None
    try:
        dt = datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
    except ValueError:
        return None
    return (dt - timedelta(hours=12)).strftime("%Y-%m-%d")

# Site coordinates are deliberately coarsened to whole degrees, matching the
# sidecars the pipeline writes (SITELAT 44.0727… -> 44). These files feed a
# public gallery; whole degrees is ~80 km of ambiguity and still records the
# observing site meaningfully. Note round(x) -> int while round(x, 0) -> float:
# the pipeline emits `44`, so the digit-less form is the matching one.

AUTHOR = {"name": "Vincent Berthier", "email": "contact@astro-hibou.eu"}

# NINA has intermittently written the site longitude with the wrong sign, so a
# header reports 7 deg WEST for a site that is 7 deg EAST — putting the
# observatory in the Atlantic off Portugal. Both observing sites used here (Nice
# at 56 m and the 1060 m mountain site) are east of Greenwich, so a negative
# longitude is always that bug rather than a real location. The correction is
# announced, never silent: if an observing site west of Greenwich is ever used,
# this is the assumption to revisit.
SITE_IS_EAST_OF_GREENWICH = True


def infer_mode(path: Path) -> str | None:
    """Pull the recombination mode out of a FITS filename."""
    stem = path.stem.upper().replace("-", "_")
    for mode in KNOWN_MODES:
        if re.search(rf"(?:^|_){re.escape(mode)}(?:_|$)", stem):
            return mode
    return None


def target_folder(path: Path) -> str | None:
    """The <target> component of dso/{process,products}/<target>/…"""
    try:
        rel = path.relative_to(DSO_ROOT)
    except ValueError:
        return None
    # rel = ("process"|"products", "<target>", …)
    return rel.parts[1] if len(rel.parts) >= 2 else None


def common_names(target: str | None) -> dict[str, str]:
    """FR/EN common names, from the hand-maintained per-target file."""
    if not target:
        return {}
    path = DSO_ROOT / "data" / target / ".common_names.yaml"
    try:
        with open(path) as f:
            return yaml.safe_load(f) or {}
    except (OSError, yaml.YAMLError):
        return {}


def read_header(path: Path) -> dict[str, Any]:
    with fits.open(path, memmap=False) as hdul:
        return dict(hdul[0].header)


def _num(header: dict, key: str) -> float | int | None:
    value = header.get(key)
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else None


def _str(header: dict, key: str) -> str | None:
    value = header.get(key)
    if not isinstance(value, str):
        return None
    value = value.strip()
    return value or None


def _prune(mapping: dict) -> OrderedDict:
    """Drop empty values so a sparse header yields a sparse sidecar rather
    than a wall of nulls."""
    return OrderedDict((k, v) for k, v in mapping.items() if v not in (None, "", {}))


def build_sidecar(header: dict, fits_path: Path, mode: str | None) -> OrderedDict:
    folder = target_folder(fits_path)
    names = common_names(folder)

    lat, lon = _num(header, "SITELAT"), _num(header, "SITELONG")
    if SITE_IS_EAST_OF_GREENWICH and lon is not None and lon < 0:
        print(f"  ! SITELONG is {lon:g} (west); correcting the NINA sign error "
              f"to {-lon:g} (east)", file=sys.stderr)
        lon = -lon
    binning_x, binning_y = _num(header, "XBINNING"), _num(header, "YBINNING")
    binning = f"{binning_x:g}x{binning_y:g}" if binning_x and binning_y else None

    target = _prune({
        "name": _str(header, "OBJECT") or (folder.upper() if folder else None),
        "common_name_fr": names.get("common_name_fr"),
        "common_name_en": names.get("common_name_en"),
        "ra_deg": _num(header, "RA"),
        "dec_deg": _num(header, "DEC"),
        "ra_hms": _str(header, "OBJCTRA"),
        "dec_dms": _str(header, "OBJCTDEC"),
    })

    # The header is wrong in both directions: LRGB drops the luminance, while
    # HOO composes ha/oiii/oiii and so counts the same OIII subs twice. The
    # per-filter masters carry each filter exactly once. Accept their sum only
    # when every channel the mode uses has a master, so a half-cleaned process
    # dir cannot be read as a short session.
    frames = _num(header, "STACKCNT")
    integration = _num(header, "LIVETIME")
    channels = channel_totals(fits_path.parent, mode)
    if channels and len(channels) == len(MODE_CHANNELS.get((mode or "").upper(), [])):
        frames = sum(c["frames"] for c in channels.values())
        integration = sum(c["integration_s"] for c in channels.values())
    else:
        channels = {}

    # Exact from the lights when the capture tree is reachable; the masters'
    # lower bound only when it is not.
    last = last_light_from_data(folder, mode) or (
        last_night(channels) if channels else None
    )
    if last and night_of(last) == night_of(_str(header, "DATE-OBS")):
        last = None  # one night: the single date already says it all
    channels = {
        n: {k: v for k, v in vals.items() if k != "date_obs_utc"}
        for n, vals in channels.items()
    }

    acquisition = _prune({
        "mode": mode,
        "date_obs_utc": _str(header, "DATE-OBS"),
        "date_last_utc": last,
        "date_avg_utc": _str(header, "DATE-AVG"),
        "date_local": _str(header, "DATE-LOC"),
        "frames_stacked": frames,
        "sub_exposure_s": _num(header, "EXPTIME"),
        "total_integration_s": integration,
        # L and RGB run different sub lengths, so one sub_exposure_s cannot
        # describe an LRGB stack — this can.
        "channels": {n: dict(v) for n, v in channels.items()} or None,
        "airmass": _num(header, "AIRMASS"),
        "altitude_deg": _num(header, "CENTALT"),
        "azimuth_deg": _num(header, "CENTAZ"),
    })

    equipment = _prune({
        "telescope": _str(header, "TELESCOP"),
        "camera": _str(header, "INSTRUME"),
        "filter_wheel": _str(header, "FWHEEL"),
        "focuser": _str(header, "FOCNAME"),
        "focal_length_mm": _num(header, "FOCALLEN"),
        "focal_ratio": _num(header, "FOCRATIO"),
        "pixel_size_um": _num(header, "XPIXSZ"),
        "binning": binning,
        "gain": _num(header, "GAIN"),
        "offset": _num(header, "OFFSET"),
        "sensor_temp_c": _num(header, "CCD-TEMP"),
    })

    site = _prune({
        "latitude_deg": round(lat) if lat is not None else None,
        "longitude_deg": round(lon) if lon is not None else None,
        "elevation_m": _num(header, "SITEELEV"),
    })

    conditions = _prune({
        "ambient_temp_c": _num(header, "AMBTEMP"),
        "humidity_pct": _num(header, "HUMIDITY"),
        "pressure_hpa": _num(header, "PRESSURE"),
        "dewpoint_c": _num(header, "DEWPOINT"),
        "cloud_cover_pct": _num(header, "CLOUDCVR"),
        "wind_dir_deg": _num(header, "WINDDIR"),
        "wind_speed_kph": _num(header, "WINDSPD"),
        "wind_gust_kph": _num(header, "WINDGUST"),
    })

    processing = _prune({
        "software": _str(header, "PROGRAM"),
        "plate_solved": bool(header["PLTSOLVD"]) if "PLTSOLVD" in header else None,
    })

    return _prune(OrderedDict([
        ("author", dict(AUTHOR)),
        ("target", target),
        ("acquisition", acquisition),
        ("equipment", equipment),
        ("site", site),
        ("conditions", conditions),
        ("processing", processing),
    ]))


def dump_sidecar(data: OrderedDict, source: Path) -> str:
    yaml.add_representer(
        OrderedDict,
        lambda d, m: d.represent_mapping("tag:yaml.org,2002:map", m.items()),
    )
    body = yaml.dump(data, sort_keys=False, allow_unicode=True, default_flow_style=False)
    return (
        "# Metadata sidecar — generated from the FITS header.\n"
        "# Edit freely: the pipeline never overwrites an existing file.\n"
        f"# Source: {source.name}\n\n"
        + body
    )


def process_one(fits_path: Path, *, mode_override: str | None, force: bool,
                dry_run: bool, verbose: bool) -> bool:
    out = fits_path.with_name(fits_path.name + ".meta.yaml")
    print(f"→ {fits_path.name}")

    if out.exists() and not force:
        print("  sidecar exists (use --force to regenerate)")
        return True

    mode = mode_override or infer_mode(fits_path)
    if not mode:
        print(f"  ! Cannot infer mode from '{fits_path.name}'; pass --mode.",
              file=sys.stderr)
        return False

    try:
        header = read_header(fits_path)
    except (OSError, ValueError) as exc:
        print(f"  ! Unreadable FITS: {exc}", file=sys.stderr)
        return False

    data = build_sidecar(header, fits_path, mode)
    if not (data.get("target") or {}).get("name"):
        print("  ! No OBJECT in header and target folder unknown; skipping.",
              file=sys.stderr)
        return False

    text = dump_sidecar(data, fits_path)
    if dry_run:
        print(f"  [dry-run] would write {out}")
        if verbose:
            print("".join(f"    {line}\n" for line in text.splitlines()))
        return True

    try:
        out.write_text(text, encoding="utf-8")
    except OSError as exc:
        print(f"  ! Write failed: {exc}", file=sys.stderr)
        return False
    print(f"  wrote {out.name}")
    return True


def expand_inputs(inputs: Iterable[Path]) -> list[Path]:
    out: list[Path] = []
    for p in inputs:
        if p.is_dir():
            out.extend(sorted(p.rglob("*.fit")))
        elif p.is_file():
            out.append(p)
        else:
            print(f"! Not found: {p}", file=sys.stderr)
    return out


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Generate a .meta.yaml sidecar from a stacked FITS header.")
    parser.add_argument("inputs", nargs="+", type=Path)
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--force", action="store_true",
                        help="Regenerate even if a sidecar already exists.")
    parser.add_argument("--mode", help="Override the inferred recombination mode.")
    args = parser.parse_args()

    targets = expand_inputs(args.inputs)
    if not targets:
        print("No FITS to process.", file=sys.stderr)
        return 1

    failures = sum(
        not process_one(p, mode_override=args.mode, force=args.force,
                        dry_run=args.dry_run, verbose=args.verbose)
        for p in targets
    )
    if failures:
        print(f"\n{failures}/{len(targets)} failed.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
