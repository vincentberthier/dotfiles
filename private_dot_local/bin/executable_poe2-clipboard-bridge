#!/usr/bin/env bash
# Bidirectional clipboard bridge between the host desktop (Wayland) and
# gamescope's nested X server.
#
# gamescope isolates its clipboard from the host in both directions
# (ValveSoftware/gamescope#1440): you can neither paste desktop content into
# the game, nor paste something copied in the game into a browser.
#
# Directions (either can be disabled):
#   host -> X   POE2_CLIP_IN=off
#   X -> host   POE2_CLIP_OUT=off
#
# The host side has a real event (`wl-paste --watch` blocks until the clipboard
# changes). The X side has no equivalent without XFixes tooling, so it polls —
# but every tick compares actual content, so it settles the moment the value
# changes rather than after a fixed delay.
#
# A single loop owns both directions and remembers the last value it synced, so
# a value pushed one way is not immediately pushed back the other.
#
# Usage:
#   poe2-clipboard-bridge [DISPLAY]      # default :1
#
# Started and stopped automatically by poe2-gamescope.
set -uo pipefail

TARGET="${1:-${GS_DISPLAY:-:1}}"
CLIP_IN="${POE2_CLIP_IN:-on}"
# Outbound defaults off: EE2 rewrites the game-side clipboard on every price
# check, and mirroring that out would continuously clobber the desktop
# clipboard with item text. Set POE2_CLIP_OUT=on if you want game -> desktop.
CLIP_OUT="${POE2_CLIP_OUT:-off}"
INTERVAL="${POE2_CLIP_INTERVAL:-0.4}"

for tool in wl-paste wl-copy xclip; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "poe2-clipboard-bridge: $tool not installed" >&2
        exit 1
    }
done

DISPLAY="$TARGET" xdpyinfo >/dev/null 2>&1 || {
    echo "poe2-clipboard-bridge: no X server on $TARGET" >&2
    exit 1
}

# Fail loudly rather than silently reading an empty clipboard forever. When
# started from poe2-gamescope this is easy to lose: that script unsets
# WAYLAND_DISPLAY so Electron does not pick the Wayland backend, and the bridge
# inherited the unset environment — so wl-paste had no compositor and no copy
# event ever arrived.
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    echo "poe2-clipboard-bridge: WAYLAND_DISPLAY is unset; nothing to read from" >&2
    logger -t poe2-clipboard-bridge "WAYLAND_DISPLAY unset, refusing to start"
    exit 1
fi
if ! wl-paste --list-types >/dev/null 2>&1; then
    echo "poe2-clipboard-bridge: cannot reach host compositor on $WAYLAND_DISPLAY" >&2
    logger -t poe2-clipboard-bridge "cannot reach compositor on $WAYLAND_DISPLAY"
    exit 1
fi

note() { logger -t poe2-clipboard-bridge "$*"; }

read_host() { wl-paste --no-newline --type text 2>/dev/null; }

# `xclip -o` blocks indefinitely if the selection owner does not answer, which
# happens readily on gamescope's display — a hung read froze the poll loop
# mid-iteration and no further copy was ever noticed. Always bound it.
read_x() { timeout 1 env DISPLAY="$TARGET" xclip -o -selection clipboard 2>/dev/null; }

# xclip -i forks and stays resident to serve the selection. Left alone these
# accumulate one pair per transfer, all competing to own the same selection,
# which is what made reads hang in the first place. Retire the previous pair
# before claiming ownership again.
owner_pids=""
write_x() {
    local p
    for p in $owner_pids; do kill "$p" 2>/dev/null; done
    owner_pids=""
    printf %s "$1" | DISPLAY="$TARGET" xclip -selection clipboard -i & owner_pids="$owner_pids $!"
    printf %s "$1" | DISPLAY="$TARGET" xclip -selection primary -i & owner_pids="$owner_pids $!"
}
write_host() { printf %s "$1" | wl-copy; }

note "bridging host <-> $TARGET (in=$CLIP_IN out=$CLIP_OUT)"

# `last` is the value both sides are believed to agree on. Only a side that
# differs from it is treated as having genuinely changed, which is what stops
# the two directions from bouncing a value back and forth forever.
last=""

# Seed: mirror whatever is already on the host clipboard, since nothing has
# "changed" yet and otherwise the first paste in the game silently does nothing.
if [ "$CLIP_IN" != off ]; then
    seed=$(read_host)
    if [ -n "$seed" ]; then
        write_x "$seed"
        last="$seed"
        note "seeded $TARGET with current host clipboard (${#seed} bytes)"
    fi
fi

# Inbound-only is the common case, and it has a real event available, so use it
# rather than polling: `wl-paste --watch` blocks in the compositor until the
# clipboard actually changes. That means no periodic process spawning at all
# while the game runs, which matters because this shares a machine with a game
# and the poll path was spawning wl-paste roughly every 0.4s.
#
# Never use `kill 0` to stop any of this: it signals the whole process group,
# which under Steam's launch chain reaches far outside this script and took down
# the niri session.
if [ "$CLIP_OUT" = off ]; then
    export POE2_BRIDGE_TARGET="$TARGET"
    # Remember what was last pushed, so a target that mirrors back to the host
    # cannot ping-pong. gamescope does not mirror back (that isolation is the
    # reason this script exists), but xwayland-satellite's :0 does, and a stray
    # run against the wrong display otherwise loops indefinitely.
    export POE2_BRIDGE_STATE
    POE2_BRIDGE_STATE=$(mktemp -t poe2-clipboard-bridge.XXXXXX)

    watch_pid=""
    cleanup() {
        [ -n "$watch_pid" ] && kill "$watch_pid" 2>/dev/null
        rm -f "$POE2_BRIDGE_STATE"
    }
    trap cleanup EXIT
    trap 'cleanup; exit 0' INT TERM

    # Deliberately NOT `exec`. exec replaces this shell, and a replaced shell
    # takes its traps with it — so the state file was leaked on every single
    # run (four stale ones found in /tmp). Keeping wl-paste as a child keeps the
    # trap alive, and lets the loop below notice if the watcher dies.
    wl-paste --type text --watch bash -c '
        text=$(cat)
        [ -z "$text" ] && exit 0
        [ "$text" = "$(cat "$POE2_BRIDGE_STATE" 2>/dev/null)" ] && exit 0
        printf %s "$text" >"$POE2_BRIDGE_STATE"
        printf %s "$text" | DISPLAY="$POE2_BRIDGE_TARGET" xclip -selection clipboard -i
        printf %s "$text" | DISPLAY="$POE2_BRIDGE_TARGET" xclip -selection primary -i
        logger -t poe2-clipboard-bridge "host -> game (${#text} bytes)"
    ' &
    watch_pid=$!

    # Stop when gamescope's display goes away, or when wl-paste itself dies —
    # the separate watchdog subshell this replaces could only see the first of
    # those, and it could not clean anything up because it signalled a process
    # that had already exec'd its trap away. Each iteration tests the real
    # condition, so the wait ends when the state changes rather than on a timer.
    while kill -0 "$watch_pid" 2>/dev/null; do
        if ! DISPLAY="$TARGET" xdpyinfo >/dev/null 2>&1; then
            note "display $TARGET gone, stopping"
            exit 0
        fi
        sleep 5
    done
    note "clipboard watcher exited, stopping"
    exit 0
fi

# Bidirectional: the X side has no change event without XFixes tooling, so this
# path polls. Only reached when outbound sync is explicitly enabled.
while DISPLAY="$TARGET" xdpyinfo >/dev/null 2>&1; do
    host=$(read_host)
    # Only read the X side when outbound sync is on. That read is the risky
    # one (it can block on an unresponsive selection owner), so for the common
    # host -> game case it is skipped entirely rather than merely bounded.
    if [ "$CLIP_OUT" != off ]; then xcb=$(read_x); else xcb=""; fi

    if [ "$CLIP_OUT" != off ] && [ -n "$xcb" ] && [ "$xcb" != "$last" ] && [ "$xcb" != "$host" ]; then
        write_host "$xcb"
        last="$xcb"
        note "game -> host (${#xcb} bytes)"
    elif [ "$CLIP_IN" != off ] && [ -n "$host" ] && [ "$host" != "$last" ] && [ "$host" != "$xcb" ]; then
        write_x "$host"
        last="$host"
        note "host -> game (${#host} bytes)"
    fi

    sleep "$INTERVAL"
done

note "display $TARGET gone, stopping"
