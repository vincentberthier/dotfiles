#!/usr/bin/env bash
# Steam launch wrapper for Path of Exile 2 under niri, with Exiled Exchange 2.
#
# Usage — Steam launch options for app 2694490:
#   poe2-gamescope %command%
#
# ---------------------------------------------------------------------------
# Why every piece of this exists
#
# 1. gamescope
#    EE2's overlay uses electron-overlay-window, which is X11-only and tracks
#    the game through _NET_ACTIVE_WINDOW / _NET_WM_NAME on the root window.
#    niri + xwayland-satellite manages nothing on the X side (no
#    _NET_CLIENT_LIST, X geometry unrelated to on-screen position), so the
#    overlay attaches to nothing and never draws. gamescope ships its own
#    Xwayland plus steamcompmgr as a real EWMH window manager, which satisfies
#    it.
#
# 2. Keyboard layout — setxkbmap on the X display is the ONLY thing that works
#
#    OBSERVED (logged every launch, journalctl -t poe2-gamescope):
#      a. gamescope's Xwayland is created with "English (US)".
#           "display :1 born with 'English (US)', forced to 'French'"
#      b. A few seconds later something pushes BEPO over it.
#           "keymap drifted to 'French (BEPO)', reapplied fr"
#
#    OBSERVED (Vincent, 2026-07-26): niri's active layout NEVER reaches the
#    game. Whatever layout niri is on at launch, PoE2 is always BEPO. Switching
#    niri beforehand does nothing; `niri msg action switch-layout` mid-session
#    does nothing. The only lever is setxkbmap against the X display the game
#    is actually using — which is exactly what this script does for gamescope's
#    display, and why it works. For a no-gamescope launch (xwayland-satellite):
#      setxkbmap -display :0 -model pc105 -layout fr
#    Verified to stick; xwayland-satellite does not stomp it back, and it
#    affects X clients only, so the Wayland desktop keeps BEPO.
#
#    UNVERIFIED — DO NOT BUILD ON IT: an earlier version of this comment
#    asserted, as one of "three measured facts", that Wine reads the X keymap
#    exactly once during its own startup and ignores every later change. That
#    was never tested, and Vincent reports behaviour inconsistent with it. The
#    tight poll below was designed around that story, so it may be solving a
#    differently-shaped problem than it claims. Test before trusting it, and do
#    not repeat the claim as fact.
#
#    Do NOT use HKCU\Keyboard Layout\Preload in the prefix as a check. It reads
#    00000409 (US) even on a launch where the keyboard is correct — it is the
#    default entry Wine writes, not a record of what it detected.
#
#    Verify with: journalctl -t poe2-gamescope
#      -> "game window present; keymap it read was '<layout>'"
#
# 3. EE2 on gamescope's display
#    EE2 has to be an X11 client of *gamescope's* X server, launched with
#    --ozone-platform=x11 or Electron picks the Wayland backend and creates no
#    window at all. It also holds a singleton lock in
#    ~/.config/exiled-exchange-2, so any stale instance must die first or the
#    new one hands off and exits. And it must not inherit Steam's environment:
#    Steam's LD_PRELOAD points at a 32-bit gameoverlayrenderer.so and
#    Chromium's zygote dies on it with
#      FATAL:zygote_host_impl_linux.cc:207] Check failed: . : Invalid argument (22)
#
# 4. Overlay atoms (gamescope's steamcompmgr.cpp)
#      STEAM_OVERLAY              -> isOverlay          (painted, input-eligible)
#      GAMESCOPE_EXTERNAL_OVERLAY -> isExternalOverlay  (painted, NEVER gets input)
#      STEAM_INPUT_FOCUS          -> inputFocusMode
#    line 3827: if ( w->isOverlay && w->inputFocusMode ) inputFocus = w;
#    line 3884: if ( inputFocusMode == 2 ) keyboardFocusWin = focusWindow;
#    So input needs STEAM_OVERLAY (not the external flag), and mode 2 sends the
#    mouse to the overlay while leaving the keyboard with the game.
#
# Environment overrides:
#   POE2_XKB_LAYOUT / POE2_XKB_VARIANT   keymap forced on gamescope's display
#   POE2_NIRI_LAYOUT                     niri layout name or index (""=skip)
#   POE2_EE2_MODE                        mouse | full | external | off
#   POE2_EE2_APPIMAGE                    path to the EE2 AppImage
#   POE2_WINDOW_TITLE                    game window title to wait for
# ---------------------------------------------------------------------------
set -uo pipefail

LAYOUT="${POE2_XKB_LAYOUT:-fr}"
VARIANT="${POE2_XKB_VARIANT:-}"
# Off by default, and it should stay that way: pinning niri buys nothing.
# Confirmed 2026-07-26 — niri's layout never reaches the game at all, with or
# without gamescope. setxkbmap against the X display is the only lever. This
# knob is kept only because it is harmless, not because it helps.
NIRI_LAYOUT="${POE2_NIRI_LAYOUT-}"
EE2="${POE2_EE2_APPIMAGE:-/home/vincent/Téléchargements/Exiled-Exchange-2-0.15.8.AppImage}"
EE2_MODE="${POE2_EE2_MODE:-mouse}"
GAME_TITLE="${POE2_WINDOW_TITLE:-Path of Exile 2}"
CLIPBOARD_BRIDGE="${POE2_CLIPBOARD_BRIDGE:-on}"
CLIP_OUT="${POE2_CLIP_OUT:-off}"
LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/poe2-gamescope"
mkdir -p "$LOGDIR"

# setup.log is opened in append mode and is written by every helper the setup
# subshell spawns, so it grows without bound across launches. Keep one previous
# session around and start fresh past a megabyte.
if [ -f "$LOGDIR/setup.log" ] && [ "$(stat -c %s "$LOGDIR/setup.log" 2>/dev/null || echo 0)" -gt 1048576 ]; then
    mv -f "$LOGDIR/setup.log" "$LOGDIR/setup.log.1"
fi

EE2_PATTERN='/tmp/\.mount_Exiled.*/exiled-exchange-2'

# --- argument parsing ------------------------------------------------------
#
# Steam invokes this as `poe2-gamescope [flags] %command%`, and %command%
# expands to the whole launch chain. So consume leading flags and treat the
# first non-flag argument as the start of the command to run.
usage() {
    cat >&2 <<'EOF'
usage: poe2-gamescope [options] COMMAND...

  --clip / --no-clip        host->game clipboard bridge (default: on)
  --clip-out / --no-clip-out
                            game->host clipboard sync (default: off; noisy,
                            EE2 rewrites the game clipboard on every price check)
  --ee2 MODE                mouse | full | external | off (default: mouse)
  --layout LAYOUT           xkb layout forced on gamescope's display (default: fr)
  -h, --help                this message

Every option also has an environment equivalent (POE2_CLIPBOARD_BRIDGE,
POE2_CLIP_OUT, POE2_EE2_MODE, POE2_XKB_LAYOUT); the flag wins.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --clip)        CLIPBOARD_BRIDGE=on;  shift ;;
        --no-clip)     CLIPBOARD_BRIDGE=off; shift ;;
        --clip-out)    CLIP_OUT=on;          shift ;;
        --no-clip-out) CLIP_OUT=off;         shift ;;
        --ee2)         EE2_MODE="${2:-mouse}";  shift 2 ;;
        --layout)      LAYOUT="${2:-fr}";       shift 2 ;;
        -h|--help)     usage; exit 0 ;;
        --)            shift; break ;;
        -*)            echo "poe2-gamescope: unknown option $1" >&2; usage; exit 2 ;;
        *)             break ;;
    esac
done

if [ $# -eq 0 ]; then
    echo "poe2-gamescope: no command given" >&2
    usage
    exit 2
fi
RESTORED_FLAG="$LOGDIR/.niri-restored.$$"

note() { logger -t poe2-gamescope "$*"; echo "poe2-gamescope: $*" >&2; }

# Kill a process and everything under it. Used so our background helpers can
# never outlive the wrapper: Steam tracks the pid it launched and waits on the
# stdout/stderr pipe, so a lingering descendant holding that pipe leaves the
# game showing as "running" in the library with nothing actually alive.
kill_tree() {
    local p="$1" c
    for c in $(pgrep -P "$p" 2>/dev/null); do kill_tree "$c"; done
    kill "$p" 2>/dev/null
}

# --- niri layout -----------------------------------------------------------

niri_layouts_json() { niri msg --json keyboard-layouts 2>/dev/null; }

# With no argument: the current index. With one: resolve a name or index.
niri_layout_index() {
    niri_layouts_json | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
if len(sys.argv) < 2:
    print(d.get("current_idx", "")); sys.exit(0)
want = sys.argv[1]
if want.lstrip("-").isdigit():
    print(want); sys.exit(0)
for i, n in enumerate(d.get("names", [])):
    if n.lower() == want.lower():
        print(i); sys.exit(0)
sys.exit(1)' ${1:+"$1"}
}

niri_saved_idx=""
restore_niri_layout() {
    [ -n "$niri_saved_idx" ] || return 0
    [ -e "$RESTORED_FLAG" ] && { niri_saved_idx=""; return 0; }
    if niri msg action switch-layout "$niri_saved_idx" >/dev/null 2>&1; then
        note "restored niri keyboard layout to $niri_saved_idx"
    fi
    : >"$RESTORED_FLAG"
    niri_saved_idx=""
}
# --- GPU performance level -------------------------------------------------
#
# Measured on an RX 9070 XT: with power_dpm_force_performance_level=auto the
# card sat pinned to DPM state 1 (1601MHz) even at 100% gpu_busy_percent, at
# 113W of a 304W cap and 53C. A vsync-limited bursty load never raises the
# governor's running average enough to reach state 2 (2400MHz), and at half
# clocks each frame overruns the 60Hz deadline, which keeps utilisation low --
# self-reinforcing. Forcing 'high' moved GPU frame time 10ms -> 7ms and the
# frame rate 38 -> 54 with power still only 119W and the card at 50C.
#
# Only held for the duration of the game, so the desktop keeps its idle clocks
# and fan curve.
GPU_PERF="${POE2_GPU_PERF:-high}"
GPU_PERF_PATH="${POE2_GPU_PERF_PATH:-}"
if [ -z "$GPU_PERF_PATH" ]; then
    for _c in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
        [ -e "$_c" ] && { GPU_PERF_PATH="$_c"; break; }
    done
fi

gpu_saved_perf=""
force_gpu_perf() {
    [ "$GPU_PERF" = off ] && return 0
    [ -n "$GPU_PERF_PATH" ] && [ -r "$GPU_PERF_PATH" ] || return 0
    gpu_saved_perf=$(cat "$GPU_PERF_PATH" 2>/dev/null)
    [ "$gpu_saved_perf" = "$GPU_PERF" ] && { gpu_saved_perf=""; return 0; }
    # doas -n so this can never prompt: Steam gives us no tty, and a wrapper
    # blocked on an invisible password prompt hangs the whole launch.
    if printf '%s\n' "$GPU_PERF" | doas -n tee "$GPU_PERF_PATH" >/dev/null 2>&1; then
        note "GPU performance level $gpu_saved_perf -> $GPU_PERF"
    else
        note "WARNING: could not set GPU performance level (needs passwordless doas)"
        gpu_saved_perf=""
    fi
}
restore_gpu_perf() {
    [ -n "$gpu_saved_perf" ] || return 0
    if printf '%s\n' "$gpu_saved_perf" | doas -n tee "$GPU_PERF_PATH" >/dev/null 2>&1; then
        note "GPU performance level restored to $gpu_saved_perf"
    fi
    gpu_saved_perf=""
}

cleanup() { restore_niri_layout; restore_gpu_perf; rm -f "$RESTORED_FLAG"; }

if [ -n "$NIRI_LAYOUT" ]; then
    target=$(niri_layout_index "$NIRI_LAYOUT")
    niri_saved_idx=$(niri_layout_index)
    if [ -z "$target" ]; then
        note "WARNING: niri layout '$NIRI_LAYOUT' not found; leaving layout alone"
        niri_saved_idx=""
    elif [ "$target" = "$niri_saved_idx" ]; then
        niri_saved_idx=""          # already correct, nothing to restore
        note "niri already on layout $target"
    elif niri msg action switch-layout "$target" >/dev/null 2>&1; then
        note "niri keyboard layout $niri_saved_idx -> $target (restored once the game has started)"
    else
        note "WARNING: could not switch niri layout to $target"
        niri_saved_idx=""
    fi
fi
trap cleanup EXIT INT TERM

# --- helpers ---------------------------------------------------------------

kill_ee2() {
    local pids
    pids=$(pgrep -f "$EE2_PATTERN" | tr '\n' ' ')
    [ -z "$pids" ] && return 0
    kill $pids 2>/dev/null
    for _ in $(seq 1 50); do
        pgrep -f "$EE2_PATTERN" >/dev/null || return 0
        sleep 0.1
    done
    # Electron's main process ignores SIGTERM when it owns a tray icon.
    pids=$(pgrep -f "$EE2_PATTERN" | tr '\n' ' ')
    [ -n "$pids" ] && kill -9 $pids 2>/dev/null
    for _ in $(seq 1 50); do
        pgrep -f "$EE2_PATTERN" >/dev/null || return 0
        sleep 0.1
    done
}

existing_displays() {
    local d
    for d in /tmp/.X11-unix/X*; do
        [ -e "$d" ] && printf '%s\n' "${d##*/X}"
    done
}

# EE2 maps a 10x10 helper window as well as the overlay; steamcompmgr only
# treats overlays wider than 1200px as the main overlay plane (line 3805).
overlay_window() {
    local w
    for w in $(xdotool search --class 'exiled-exchange-2' 2>/dev/null); do
        eval "$(xdotool getwindowgeometry --shell "$w" 2>/dev/null)"
        [ "${WIDTH:-0}" -gt 1200 ] && { echo "$w"; return 0; }
    done
    return 1
}

before=$(existing_displays | sort -u | tr '\n' ' ')

# --- post-launch setup, once gamescope's Xwayland appears ------------------

(
    # Everything below inherits Steam's environment, which puts both the 32-bit
    # and 64-bit gameoverlayrenderer.so in LD_PRELOAD. None of the helpers here
    # are the game: the 32-bit object fails the ELF-class check and prints an
    # error on *every* spawn, and the 64-bit one gets mapped and initialised for
    # nothing. Measured before this line existed: ~1.6 lines/s of ld.so noise
    # into setup.log for the entire session, one pointless library load per
    # xkbcomp / xdotool / rg / sleep. EE2 gets the same treatment explicitly
    # further down; it needs it for a different reason (Chromium's zygote dies
    # on the 32-bit object rather than just complaining).
    unset LD_PRELOAD LD_LIBRARY_PATH

    newdisp=""
    for _ in $(seq 1 900); do
        for d in $(existing_displays); do
            case " $before " in
                *" $d "*) ;;
                *) newdisp="$d"; break ;;
            esac
        done
        [ -n "$newdisp" ] && break
        sleep 0.1
    done
    if [ -z "$newdisp" ]; then
        note "gamescope X display never appeared; skipping setup"
        restore_niri_layout
        exit 0
    fi

    export DISPLAY=":$newdisp"
    # Remember the host compositor before dropping it: the clipboard bridge
    # needs to talk to niri via wl-paste/wl-copy, while everything else here
    # (EE2 especially) must NOT see WAYLAND_DISPLAY or Electron picks the
    # Wayland backend and creates no window at all.
    HOST_WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}"
    unset WAYLAND_DISPLAY

    # Stay alive as long as the helpers we started are alive, instead of
    # returning as soon as setup is done.
    #
    # This subshell is what `kill_tree "$setup_pid"` tears down at game exit.
    # When it exited early, the keymap watcher and the clipboard bridge were
    # reparented to init, kill_tree found no children left to walk, and they
    # survived the game. Observed: a bridge from a 19:51:30 launch still running
    # 57 minutes later next to the current one, both watching the same host
    # clipboard and both claiming the selection on :1.
    hold() { wait; exit 0; }

    for _ in $(seq 1 100); do
        xdpyinfo >/dev/null 2>&1 && break
        sleep 0.1
    done

    # The real keymap, not _XKB_RULES_NAMES — that property lags and reported
    # "us" while the live keymap was BEPO.
    # rg rather than python3: this runs on every tick of the watcher below for
    # the whole session, and a Python interpreter startup per tick is by far the
    # most expensive thing in the loop. Verified to return the same value as the
    # regex it replaces against a live gamescope display.
    current_layout() {
        xkbcomp -xkb "$DISPLAY" - 2>/dev/null |
            rg -o -m1 -r '$1' 'name\[[Gg]roup1\]\s*=\s*"([^"]*)"'
    }
    apply_layout() {
        setxkbmap -model pc105 -layout "$LAYOUT" ${VARIANT:+-variant "$VARIANT"} 2>/dev/null
    }

    # Force the layout the moment the display exists, and hold it from there.
    #
    # Measured sequence without this: the Xwayland is created with
    # "English (US)", then gamescope pushes niri's live layout over it a few
    # seconds later, and Wine — which reads the keymap once, during its own
    # startup, in that same window — caches whatever happened to be there.
    # Applying after the game window appears is far too late; that is what the
    # earlier version of this script did, and the game stayed on BEPO.
    #
    # The poll is deliberately tight while Wine is starting up, because a
    # single missed push in that window poisons the whole session, then backs
    # off once the game is up and only EE2's uiohook keycode mapping cares.
    born=$(current_layout)
    apply_layout
    want=$(current_layout)
    note "display $DISPLAY born with '$born', forced to '$want'"

    [ -z "$want" ] || ( interval=0.25
      game_seen=0
      while xdpyinfo >/dev/null 2>&1; do
          got=$(current_layout)
          if [ -n "$got" ] && [ "$got" != "$want" ]; then
              apply_layout
              note "keymap drifted to '$got', reapplied $LAYOUT"
          fi
          if [ "$game_seen" = 0 ] && xdotool search --name "$GAME_TITLE" 2>/dev/null | rg -q .; then
              game_seen=1
              note "game window present; keymap it read was '$(current_layout)'"
              interval=2      # Wine has cached by now; stop hammering
          fi
          sleep "$interval"
      done ) &

    # Host clipboard -> gamescope, so desktop copies can be pasted into the
    # game and into EE2. gamescope isolates its clipboard in both directions
    # (gamescope#1440) and nothing upstream brings the host's clipboard in.
    if [ "$CLIPBOARD_BRIDGE" != off ] && command -v poe2-clipboard-bridge >/dev/null 2>&1; then
        if [ -z "$HOST_WAYLAND_DISPLAY" ]; then
            note "clipboard bridge skipped: no host WAYLAND_DISPLAY to read from"
        elif command -v xclip >/dev/null 2>&1; then
            WAYLAND_DISPLAY="$HOST_WAYLAND_DISPLAY" POE2_CLIP_OUT="$CLIP_OUT" \
                poe2-clipboard-bridge "$DISPLAY" &
            note "clipboard bridge started (host $HOST_WAYLAND_DISPLAY -> $DISPLAY, out=$CLIP_OUT)"
        else
            note "clipboard bridge skipped: xclip not installed"
        fi
    fi

    if [ "$EE2_MODE" = off ] || [ ! -x "$EE2" ]; then
        [ "$EE2_MODE" = off ] || note "EE2 not found at $EE2; skipping"
        hold
    fi

    kill_ee2
    setsid env -u LD_PRELOAD -u LD_LIBRARY_PATH -u STEAM_RUNTIME \
        -u STEAM_COMPAT_DATA_PATH -u STEAM_COMPAT_CLIENT_INSTALL_PATH \
        -u SteamAppId -u SteamGameId -u SteamOverlayGameId \
        "$EE2" --ozone-platform=x11 >"$LOGDIR/ee2.log" 2>&1 </dev/null &
    disown
    note "launched EE2 on $DISPLAY"

    win=""
    for _ in $(seq 1 600); do
        win=$(overlay_window) && [ -n "$win" ] && break
        pgrep -f "$EE2_PATTERN" >/dev/null || break     # it died; stop waiting
        sleep 0.1
    done
    if [ -z "$win" ]; then
        if pgrep -f "$EE2_PATTERN" >/dev/null; then
            note "EE2 is running but its overlay window never appeared"
        else
            note "EE2 exited during startup; see $LOGDIR/ee2.log"
        fi
        hold
    fi

    xprop -id "$win" -remove GAMESCOPE_EXTERNAL_OVERLAY 2>/dev/null
    xprop -id "$win" -remove STEAM_OVERLAY 2>/dev/null
    xprop -id "$win" -remove STEAM_INPUT_FOCUS 2>/dev/null
    case "$EE2_MODE" in
        mouse)    xprop -id "$win" -f STEAM_OVERLAY 32c -set STEAM_OVERLAY 1
                  xprop -id "$win" -f STEAM_INPUT_FOCUS 32c -set STEAM_INPUT_FOCUS 2 ;;
        full)     xprop -id "$win" -f STEAM_OVERLAY 32c -set STEAM_OVERLAY 1
                  xprop -id "$win" -f STEAM_INPUT_FOCUS 32c -set STEAM_INPUT_FOCUS 1 ;;
        external) xprop -id "$win" -f GAMESCOPE_EXTERNAL_OVERLAY 32c -set GAMESCOPE_EXTERNAL_OVERLAY 1 ;;
    esac
    note "EE2 overlay window $win set to mode=$EE2_MODE"
    hold
) >>"$LOGDIR/setup.log" 2>&1 &
setup_pid=$!
# ^ output goes to a file, not Steam's pipe. Everything still reaches the
#   journal via note()/logger, so `journalctl -t poe2-gamescope` is unaffected.

gamescope -w 3840 -h 2160 -W 3840 -H 2160 -f -- "$@"
rc=$?

# Tear down our helpers before returning, so Steam sees the process tree empty.
kill_tree "$setup_pid"
# Do not leave EE2 running: its singleton lock would block the next launch.
kill_ee2
note "game exited (rc=$rc), EE2 and helpers stopped"
exit $rc
